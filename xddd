<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E6FA"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTytul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Losowanie kostek"
        android:textColor="#333333"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLiczbaKostek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Liczba kostek:"
        android:textColor="#333333"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/etLiczbaKostek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="5"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnLosuj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#6750A4"
        android:text="Losuj"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvWylosowaneNaglowek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Wylosowane kostki:"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWylosowaneKostki"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvWynikiNaglowek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Wyniki:"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWyniki"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Wyniki pojawią się tutaj"
        android:textColor="#555555"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnSortujRosnaco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#6750A4"
        android:text="Sortuj rosnąco"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSortujMalejaco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#6750A4"
        android:text="Sortuj malejąco"
        android:textColor="#FFFFFF" />

</LinearLayout>
