package com.example.fiszkiapp;

public class Fiszka {

    private String pytanie;
    private String odpowiedz;

    public Fiszka(String pytanie, String odpowiedz) {
        this.pytanie = pytanie;
        this.odpowiedz = odpowiedz;
    }

    public String getPytanie() {
        return pytanie;
    }

    public String getOdpowiedz() {
        return odpowiedz;
    }

    @Override
    public String toString() {
        return "Pytanie: " + pytanie + " | Odpowiedź: " + odpowiedz;
    }
}













<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/sekcjaKreatora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editPytanie"
            android:hint="Wpisz pytanie"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editodpowiedz"
            android:hint="Wpisz odpowiedz"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/butDodaj"
            android:text="Dodaj"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/startquiz"
            android:text="rozpocznij"
            android:layout_marginTop="8dp"/>

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="300dp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/sekcjaQuiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/pytaniequiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pytanie"
            android:textSize="24sp"
            android:padding="16dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/odpowiedzquiz"
            android:hint="wpisz odpowiedz:"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="sprawdz odpowiedz"
            android:layout_marginTop="8dp"
            android:id="@+id/sprawdz"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/zakoncz"
            android:text="zakoncz"
            android:layout_marginTop="8dp"/>

    </LinearLayout>




</LinearLayout>
