package com.twojeimie.myapplication;

import android.os.Bundle;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ListView;
import android.widget.TextView;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

import java.util.ArrayList;
import java.util.Random;

public class MainActivity extends AppCompatActivity {

    EditText editpyt, editodp, odpowiedzquiz;
    Button butn, startquiz, sprawdz, zakoncz;
    ListView lista;
    TextView pytaniequiz;
    LinearLayout sKreatora, sQuiz;

    ArrayList<Fiszka> listaFiszek;
    ArrayAdapter<Fiszka> adapter;

    Fiszka aktualnaFiszka;
    Random random = new Random();

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        editodp = findViewById(R.id.editodpowiedz);
        editpyt = findViewById(R.id.editPytanie);
        butn = findViewById(R.id.butDodaj);
        lista = findViewById(R.id.lista);

        odpowiedzquiz = findViewById(R.id.odpowiedzquiz);
        startquiz = findViewById(R.id.startquiz);
        sprawdz = findViewById(R.id.sprawdz);
        zakoncz = findViewById(R.id.zakoncz);
        pytaniequiz = findViewById(R.id.pytaniequiz);

        sKreatora = findViewById(R.id.sekcjaKreatora);
        sQuiz = findViewById(R.id.sekcjaQuiz);

        listaFiszek = new ArrayList<>();

        adapter = new ArrayAdapter<>(
                this,
                android.R.layout.simple_list_item_1,
                listaFiszek
        );

        lista.setAdapter(adapter);

        butn.setOnClickListener(v -> dodajFiszke());

        startquiz.setOnClickListener(v -> {

            if (listaFiszek.isEmpty()) {
                Toast.makeText(
                        MainActivity.this,
                        "Brak fiszek!",
                        Toast.LENGTH_SHORT
                ).show();
                return;
            }

            sKreatora.setVisibility(View.GONE);
            sQuiz.setVisibility(View.VISIBLE);

            odpowiedzquiz.setText("");

            wylosujFiszke();
        });

        sprawdz.setOnClickListener(v -> sprawdzOdpowiedz());

        zakoncz.setOnClickListener(v -> {

            sKreatora.setVisibility(View.VISIBLE);
            sQuiz.setVisibility(View.GONE);

        });

        aktualizujPrzyciskQuiz();
    }

    void dodajFiszke() {

        String pyt = editpyt.getText().toString().trim();
        String odp = editodp.getText().toString().trim();

        if (pyt.isEmpty() || odp.isEmpty()) {

            Toast.makeText(
                    this,
                    "Uzupełnij oba pola",
                    Toast.LENGTH_SHORT
            ).show();

            return;
        }

        Fiszka nowa = new Fiszka(pyt, odp);

        listaFiszek.add(nowa);

        adapter.notifyDataSetChanged();

        editpyt.setText("");
        editodp.setText("");

        aktualizujPrzyciskQuiz();
    }

    void wylosujFiszke() {

        int indeks = random.nextInt(listaFiszek.size());

        aktualnaFiszka = listaFiszek.get(indeks);

        pytaniequiz.setText(aktualnaFiszka.getPytanie());
    }

    void sprawdzOdpowiedz() {

        String wpisana =
                odpowiedzquiz.getText().toString().trim();

        String poprawna =
                aktualnaFiszka.getOdpowiedz().trim();

        if (wpisana.equalsIgnoreCase(poprawna)) {

            Toast.makeText(
                    this,
                    "Poprawna odpowiedź!",
                    Toast.LENGTH_SHORT
            ).show();

        } else {

            Toast.makeText(
                    this,
                    "Błędna odpowiedź!\nPoprawna: " + poprawna,
                    Toast.LENGTH_SHORT
            ).show();
        }

        odpowiedzquiz.setText("");

        wylosujFiszke();
    }

    void aktualizujPrzyciskQuiz() {

        startquiz.setEnabled(!listaFiszek.isEmpty());
    }
}









